# Copy to .env (never committed). 01-architecture §6.
DATABASE_URL=postgres://mini:mini@localhost:5432/mini   # Aiven: postgres://mini_app:…@<service>.aivencloud.com:<port>/defaultdb?sslmode=verify-full
TEST_DATABASE_URL=postgres://mini:mini@localhost:5432/mini_test   # pnpm test; local Docker only
DATABASE_CA_CERT=                            # Aiven only: ./var/aiven-ca.pem (project CA certificate)
MINI_APP_PASSWORD=                           # Aiven only: login password set on role mini_app by pnpm db:migrate
DB_POOL_MAX=5                                # server connections; keep small on the 1-CPU plan
PREVIEW_TIMEOUT_MS=30000                     # pipeline previews (agent SQL stays at 5 s)
ANTHROPIC_API_KEY=                           # set by the team, never committed
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
LLM_JUDGE_MODEL=claude-opus-5-5
LLM_MAX_CONTEXT_TOKENS=200000
COOKIE_SECRET=change-me-to-a-long-random-string
DATA_DIR=./var/uploads                       # raw uploaded files kept for audit (git-ignored)
UPLOAD_MAX_MB=400
PORT=4000

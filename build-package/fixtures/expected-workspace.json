{
  "_note": "Kumo demo workspace (02-slice-and-demo.md), a target for tests, the mock replay and the agent. Names may differ in a live run. <...DatasetId> placeholders are replaced by the test (or the seed) with the project's dataset ids. Column names are the snake_cased headers of the kumo-mini files; the ones listed in _assumptions are not yet confirmed by the fixture. Composite keys can't be built (LogicExpr has no concat), so CuisineJour is keyed on the dataset column cle_cuisine_jour.",
  "_assumptions": [
    "CAPACITE_CUISINES_JOUR_2025 has a key column cle_cuisine_jour (unique per kitchen-day, e.g. 'Frepillon|2025-10-14') plus cuisine, date and capacite_unites columns (names ASSUMED)",
    "CUISINES_REFERENTIEL has a cuisine column holding the kitchen name (ASSUMED)",
    "APP_KIOSQUE_INVENDUS_2025 has id_invendu (unique), id_interne_client_netsuite, id_interne_article, date and quantite (ASSUMED)",
    "COMMANDES_NETSUITE_2025 has date_production (spec 02 section 3) next to lieu_production; each SO document is produced in one kitchen on one day",
    "CLIENTS_NETSUITE columns: id_interne, zone_distribution, actif; ARTICLES_NETSUITE: id_interne, nom_article, dlc, date_de_cr_ation, article_actif"
  ],
  "semanticVersion": "v0",
  "pipelines": [
    {
      "apiName": "commandes",
      "description": "Sales orders rolled up from order lines to one row per document (SO-...).",
      "terms": [
        "T_commande"
      ],
      "nodes": [
        {
          "id": "lignes",
          "kind": "source",
          "datasetId": "<commandesDatasetId>"
        },
        {
          "id": "so",
          "kind": "filter",
          "input": "lignes",
          "where": {
            "kind": "cmp",
            "property": "no_transaction",
            "op": "startsWith",
            "value": "SO-"
          }
        },
        {
          "id": "docs",
          "kind": "aggregate",
          "input": "so",
          "groupBy": [
            "no_transaction",
            "date",
            "id_interne_client_netsuite"
          ],
          "measures": [
            {
              "as": "lignes",
              "fn": "count"
            },
            {
              "as": "quantite",
              "fn": "sum",
              "column": "quantite"
            }
          ]
        }
      ],
      "outputs": [
        {
          "apiName": "commandes",
          "node": "docs"
        }
      ],
      "checks": [
        {
          "output": "commandes",
          "kind": "unique",
          "columns": [
            "no_transaction"
          ]
        },
        {
          "output": "commandes",
          "kind": "notNull",
          "columns": [
            "id_interne_client_netsuite"
          ]
        }
      ]
    },
    {
      "apiName": "retours",
      "description": "Returns (RMA-... documents, negative quantities) rolled up to one row per document, with the quantity returned as a positive number.",
      "terms": [
        "T_retour"
      ],
      "nodes": [
        {
          "id": "lignes",
          "kind": "source",
          "datasetId": "<commandesDatasetId>"
        },
        {
          "id": "rma",
          "kind": "filter",
          "input": "lignes",
          "where": {
            "kind": "cmp",
            "property": "no_transaction",
            "op": "startsWith",
            "value": "RMA-"
          }
        },
        {
          "id": "docs",
          "kind": "aggregate",
          "input": "rma",
          "groupBy": [
            "no_transaction",
            "date",
            "id_interne_client_netsuite"
          ],
          "measures": [
            {
              "as": "lignes",
              "fn": "count"
            },
            {
              "as": "quantite",
              "fn": "sum",
              "column": "quantite"
            }
          ]
        },
        {
          "id": "positifs",
          "kind": "derive",
          "input": "docs",
          "as": "quantite_retournee",
          "expr": {
            "mul": [
              {
                "property": "quantite"
              },
              {
                "literal": -1
              }
            ]
          }
        }
      ],
      "outputs": [
        {
          "apiName": "retours",
          "node": "positifs"
        }
      ],
      "checks": [
        {
          "output": "retours",
          "kind": "unique",
          "columns": [
            "no_transaction"
          ]
        }
      ]
    },
    {
      "apiName": "flux_article",
      "description": "Quantities delivered and returned per article, over all orders and returns.",
      "terms": [
        "T_article",
        "T_retour"
      ],
      "nodes": [
        {
          "id": "lignes",
          "kind": "source",
          "datasetId": "<commandesDatasetId>"
        },
        {
          "id": "livre",
          "kind": "derive",
          "input": "lignes",
          "as": "livre",
          "expr": {
            "case": [
              {
                "when": {
                  "kind": "cmp",
                  "property": "no_transaction",
                  "op": "startsWith",
                  "value": "SO-"
                },
                "then": {
                  "property": "quantite"
                }
              }
            ],
            "else": {
              "literal": 0
            }
          }
        },
        {
          "id": "retourne",
          "kind": "derive",
          "input": "livre",
          "as": "retourne",
          "expr": {
            "case": [
              {
                "when": {
                  "kind": "cmp",
                  "property": "no_transaction",
                  "op": "startsWith",
                  "value": "RMA-"
                },
                "then": {
                  "mul": [
                    {
                      "property": "quantite"
                    },
                    {
                      "literal": -1
                    }
                  ]
                }
              }
            ],
            "else": {
              "literal": 0
            }
          }
        },
        {
          "id": "par_article",
          "kind": "aggregate",
          "input": "retourne",
          "groupBy": [
            "id_interne_article"
          ],
          "measures": [
            {
              "as": "livre",
              "fn": "sum",
              "column": "livre"
            },
            {
              "as": "retourne",
              "fn": "sum",
              "column": "retourne"
            }
          ]
        }
      ],
      "outputs": [
        {
          "apiName": "flux",
          "node": "par_article"
        }
      ],
      "checks": [
        {
          "output": "flux",
          "kind": "unique",
          "columns": [
            "id_interne_article"
          ]
        }
      ]
    },
    {
      "apiName": "production",
      "description": "Production lots: sales orders with a known kitchen and production day (recorded from August only), one row per order.",
      "terms": [
        "T_lot_production",
        "T_cuisine"
      ],
      "nodes": [
        {
          "id": "lignes",
          "kind": "source",
          "datasetId": "<commandesDatasetId>"
        },
        {
          "id": "produites",
          "kind": "filter",
          "input": "lignes",
          "where": {
            "kind": "and",
            "filters": [
              {
                "kind": "cmp",
                "property": "no_transaction",
                "op": "startsWith",
                "value": "SO-"
              },
              {
                "kind": "cmp",
                "property": "lieu_production",
                "op": "notNull"
              },
              {
                "kind": "cmp",
                "property": "date_production",
                "op": "notNull"
              }
            ]
          }
        },
        {
          "id": "lots",
          "kind": "aggregate",
          "input": "produites",
          "groupBy": [
            "no_transaction",
            "lieu_production",
            "date_production"
          ],
          "measures": [
            {
              "as": "quantite",
              "fn": "sum",
              "column": "quantite"
            }
          ]
        }
      ],
      "outputs": [
        {
          "apiName": "lots",
          "node": "lots"
        }
      ],
      "checks": [
        {
          "output": "lots",
          "kind": "unique",
          "columns": [
            "no_transaction"
          ]
        },
        {
          "output": "lots",
          "kind": "notNull",
          "columns": [
            "lieu_production",
            "date_production"
          ]
        }
      ]
    },
    {
      "apiName": "cuisine_jours",
      "description": "Capacity per kitchen and day, summed over workshops and shifts (simulated data).",
      "terms": [
        "T_capacite",
        "T_cuisine"
      ],
      "nodes": [
        {
          "id": "capacite",
          "kind": "source",
          "datasetId": "<capaciteDatasetId>"
        },
        {
          "id": "par_jour",
          "kind": "aggregate",
          "input": "capacite",
          "groupBy": [
            "cle_cuisine_jour",
            "cuisine",
            "date"
          ],
          "measures": [
            {
              "as": "capacite",
              "fn": "sum",
              "column": "capacite_unites"
            }
          ]
        }
      ],
      "outputs": [
        {
          "apiName": "cuisine_jours",
          "node": "par_jour"
        }
      ],
      "checks": [
        {
          "output": "cuisine_jours",
          "kind": "unique",
          "columns": [
            "cle_cuisine_jour"
          ]
        }
      ]
    }
  ],

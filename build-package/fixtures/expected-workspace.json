      "reverseDisplayName": "Orders",
      "description": "The client who placed the order."
    },
    {
      "apiName": "client",
      "from": "Retour",
      "to": "Client",
      "cardinality": "many-to-one",
      "keys": [
        {
          "fromProperty": "clientId",
          "toProperty": "clientId"
        }
      ],
      "relation": "R_retour_client",
      "displayName": "Client",
      "reverseApiName": "retours",
      "reverseDisplayName": "Returns",
      "description": "The client who sent the goods back."
    },
    {
      "apiName": "article",
      "from": "FluxArticle",
      "to": "Article",
      "cardinality": "one-to-one",
      "keys": [
        {
          "fromProperty": "articleId",
          "toProperty": "articleId"
        }
      ],
      "relation": "R_flux_article",
      "displayName": "Article",
      "reverseApiName": "flux",
      "reverseDisplayName": "Movements",
      "description": "The article these totals are about."
    },
    {
      "apiName": "cuisineJour",
      "from": "LotProduction",
      "to": "CuisineJour",
      "cardinality": "many-to-one",
      "keys": [
        {
          "fromProperty": "lieuProduction",
          "toProperty": "cuisine"
        },
        {
          "fromProperty": "dateProduction",
          "toProperty": "jour"
        }
      ],
      "relation": "R_lot_cuisine_jour",
      "displayName": "Kitchen-day",
      "reverseApiName": "lots",
      "reverseDisplayName": "Production lots",
      "description": "The kitchen and day the lot is produced on, matched on both."
    },
    {
      "apiName": "site",
      "from": "CuisineJour",
      "to": "Cuisine",
      "cardinality": "many-to-one",
      "keys": [
        {
          "fromProperty": "cuisine",
          "toProperty": "cuisineId"
        }
      ],
      "relation": "R_cuisine_jour_cuisine",
      "displayName": "Kitchen",
      "reverseApiName": "jours",
      "reverseDisplayName": "Kitchen-days",
      "description": "The kitchen this day of capacity belongs to."
    },
    {
      "apiName": "client",
      "from": "Invendu",
      "to": "Client",
      "cardinality": "many-to-one",
      "keys": [
        {
          "fromProperty": "clientId",
          "toProperty": "clientId"
        }
      ],
      "relation": "R_invendu_client",
      "displayName": "Client",
      "reverseApiName": "invendus",
      "reverseDisplayName": "Unsold declarations",
      "description": "The store that declared the unsold goods."
    },
    {
      "apiName": "article",
      "from": "Invendu",
      "to": "Article",
      "cardinality": "many-to-one",
      "keys": [
        {
          "fromProperty": "articleId",
          "toProperty": "articleId"
        }
      ],
      "relation": "R_invendu_article",
      "displayName": "Article",
      "reverseApiName": "invendus",
      "reverseDisplayName": "Unsold declarations",
      "description": "The article left unsold."
    }
  ],
  "logic": [
    {
      "apiName": "nbCommandes",
      "objectType": "Client",
      "kind": "derived",
      "type": "integer",
      "expr": {
        "aggregate": {
          "link": "commandes",
          "fn": "count"
        }
      },
      "displayName": "Orders placed",
      "description": "How many sales orders the client placed this year."
    },
    {
      "apiName": "tauxRetour",
      "objectType": "Client",
      "kind": "derived",
      "type": "double",
      "expr": {
        "div": [
          {
            "coalesce": [
              {
                "aggregate": {
                  "link": "retours",
                  "fn": "sum",
                  "property": "quantiteRetournee"
                }
              },
              {
                "literal": 0
              }
            ]
          },
          {
            "aggregate": {
              "link": "commandes",
              "fn": "sum",
              "property": "quantite"
            }
          }
        ]
      },
      "displayName": "Return rate",
      "description": "Quantity returned divided by quantity delivered; empty when the client received nothing.",
      "constraints": [
        "C_rma_negatif"
      ]
    },
    {
      "apiName": "tauxRetour",
      "objectType": "Article",
      "kind": "derived",
      "type": "double",
      "expr": {
        "div": [
          {
            "aggregate": {
              "link": "flux",
              "fn": "sum",
              "property": "retourne"
            }
          },
          {
            "aggregate": {
              "link": "flux",
              "fn": "sum",
              "property": "livre"
            }
          }
        ]
      },
      "displayName": "Return rate",
      "description": "Quantity returned divided by quantity delivered for the article; empty when none was delivered.",
      "constraints": [
        "C_rma_negatif"
      ]
    },
    {
      "apiName": "charge",
      "objectType": "CuisineJour",
      "kind": "derived",
      "type": "integer",
      "expr": {
        "coalesce": [
          {
            "aggregate": {
              "link": "lots",
              "fn": "sum",
              "property": "quantite"
            }
          },
          {
            "literal": 0
          }
        ]
      },
      "displayName": "Load",
      "description": "Units planned in this kitchen on this day: the sum of its production lots."
    },
    {
      "apiName": "surcharge",
      "objectType": "CuisineJour",
      "kind": "rule",
      "condition": {
        "kind": "cmpProps",
        "left": "charge",
        "op": "gt",
        "right": "capacite"
      },
      "displayName": "Over capacity",
      "description": "True when more units are planned than the kitchen can produce that day.",
      "constraints": [
        "C_capacite_simulee"
      ]
    }
  ],
  "actionTypes": [
    {
      "apiName": "ReaffecterProduction",
      "displayName": "Move a production",
      "description": "Move a production lot to another kitchen, as long as that kitchen stays within its capacity that day.",
      "agentDescription": "Use to move a production lot to another kitchen. Sets the lot kitchen (lieuProduction). Refused when the target kitchen-day would be over capacity once the lot is added; check with a dry run first.",
      "constraints": [
        "C_capacite_simulee"
      ],
      "parameters": [
        {
          "id": "lot",
          "kind": "object",
          "objectType": "LotProduction",
          "displayName": "Lot",
          "description": "The production lot to move.",
          "required": true
        },
        {
          "id": "cible",
          "kind": "value",
          "type": "string",
          "allowedValues": [
            "Gennevilliers",
            "Frepillon",
            "Draveil"
          ],
          "displayName": "Target kitchen",
          "description": "The kitchen that should produce it.",
          "required": true
        }
      ],
      "rules": [
        {
          "kind": "modifyObject",
          "object": "lot",
          "set": {
            "lieuProduction": {
              "kind": "param",
              "param": "cible"
            }
          }
        }
      ],
      "submissionCriteria": [
        {
          "kind": "rule",
          "objectType": "CuisineJour",
          "rule": "surcharge",
          "object": {
            "kind": "lookup",
            "objectType": "CuisineJour",
            "keys": {
              "cuisine": {
                "kind": "param",
                "param": "cible"
              },
              "jour": {
                "kind": "paramProperty",
                "param": "lot",
                "property": "dateProduction"
              }
            }
          },
          "expect": false,
          "afterEdits": true,
          "failureMessage": "{{cible}} would be over capacity on that day."
        }
      ],
      "successMessage": "Lot {{lot.lotId}} is now produced in {{cible}}."
    },
    {
      "apiName": "DeclarerInvendus",
      "displayName": "Declare unsold goods",
      "description": "Record unsold goods for a store and an article.",
      "agentDescription": "Use when a store reports unsold goods. Creates an Invendu linked to the client and the article; needs a new unique reference and a positive quantity.",
      "parameters": [
        {
          "id": "reference",
          "kind": "value",
          "type": "string",
          "displayName": "Reference",
          "description": "A new unique reference for the declaration.",
          "required": true
        },
        {
          "id": "client",
          "kind": "object",
          "objectType": "Client",
          "displayName": "Client",
          "description": "The store declaring.",
          "required": true
        },
        {
          "id": "article",
          "kind": "object",
          "objectType": "Article",
          "displayName": "Article",
          "description": "The article left unsold.",
          "required": true
        },
        {
          "id": "quantite",
          "kind": "value",
          "type": "integer",
          "displayName": "Quantity",
          "description": "Units left unsold.",
          "required": true
        }
      ],
      "rules": [
        {
          "kind": "createObject",
          "objectType": "Invendu",
          "primaryKey": {
            "kind": "param",
            "param": "reference"
          },
          "set": {
            "clientId": {
              "kind": "param",
              "param": "client"
            },
            "articleId": {
              "kind": "param",
              "param": "article"
            },
            "quantite": {
              "kind": "param",
              "param": "quantite"
            },
            "date": {
              "kind": "now"
            }
          }
        }
      ],
      "submissionCriteria": [
        {
          "kind": "compare",
          "left": {
            "kind": "param",
            "param": "quantite"
          },
          "op": "gt",
          "right": {
            "kind": "literal",
            "value": 0
          },
          "failureMessage": "The quantity must be more than zero."
        }
      ],
      "successMessage": "Declared {{quantite}} unsold units for {{client.clientId}}."
    }
  ],
  "apps": [],
  "automations": [
    {
      "id": "alerte-surcharge",
      "name": "Over-capacity alert",
      "description": "Warn the person who made the change when a kitchen-day goes over capacity.",
      "condition": {
        "kind": "objectsEnterSet",
        "set": {
          "kind": "filter",
          "of": {
            "kind": "all",
            "objectType": "CuisineJour"
          },
          "where": {
            "kind": "rule",
            "rule": "surcharge"
          }
        }
      },
      "effects": [
        {
          "kind": "notify",
          "recipients": [
            {
              "kind": "currentUser"
            }
          ],
          "title": "Kitchen over capacity",
          "body": "{{object.cle}} is planned above its capacity."
        }
      ]
    }
  ]
}

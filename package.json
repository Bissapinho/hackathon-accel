{
  "name": "mini-foundry",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @mini/server dev",
    "web": "node apps/web/serve.mjs",
    "db:migrate": "pnpm --filter @mini/server db:migrate",
    "db:seed": "pnpm --filter @mini/server db:seed",
    "db:wipe": "pnpm --filter @mini/server db:wipe",
    "seed:kumo": "pnpm --filter @mini/server seed:kumo",
    "test": "pnpm --filter @mini/server test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}

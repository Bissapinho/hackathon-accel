    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.7",
    "kysely": "^0.28.18",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
